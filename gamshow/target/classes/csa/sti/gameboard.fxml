<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csa.sti.Gameboard" stylesheets = "@style.css" styleClass="gameboard">
   <children>
      <Label text="Gameboard" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
      <GridPane fx:id="board" alignment="CENTER" hgap="10.0" vgap="10.0" />
      <HBox spacing="30" alignment="CENTER">
            <Label fx:id="team1ScoreLabel" text="Team 1: 0" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <Label fx:id="team2ScoreLabel" text="Team 2: 0" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
      </HBox>
      <HBox spacing="10" alignment="CENTER">    
            <Button fx:id="giveButton1" text="Give to Team 1" /> <!--Add an action like: onAction="#giveTeam1" for this and for the rest of them and just create it-->
            <Button fx:id="giveButton2" text="Give to Team 2" />
            <Button fx:id="takeAwayButton" text="Take from Team 1"/> 
      </HBox>
      <Button fx:id="gameboardButton" text="Switch to Leaderboard" onAction="#switchToLeaderboard"/>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>

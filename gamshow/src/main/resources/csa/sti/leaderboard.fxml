<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csa.sti.Leaderboard">
    <children>
        <Label text="Leaderboard" />
        <TableView fx:id="leaderboardTable" prefHeight="200.0" prefWidth="300.0">
            <columns>
                <TableColumn fx:id="rankColumn" text="Rank" />
                <TableColumn fx:id="nameColumn" text="Name" />
                <TableColumn fx:id="scoreColumn" text="Score" />
            </columns>
        </TableView>
        <Button fx:id="leaderboardButton" text="Switch to Gameboard" onAction="#switchToGameboard" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>

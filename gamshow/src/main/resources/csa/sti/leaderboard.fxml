<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="csa.sti.Leaderboard" stylesheets="@style.css">
    <children>
        <Label text = "LEADERBOARD" styleClass="title" />
        <TableView fx:id="leaderboardTable" prefHeight="200.0" maxWidth="550.0">
            <columns>
                <TableColumn fx:id="streakColumn" text="Streak" /> 
                <TableColumn fx:id="rankColumn" text="Rank" />
                <TableColumn fx:id="nameColumn" prefWidth="200.0" text="Team Name" />
                <TableColumn fx:id="scoreColumn" prefWidth="200.0" text="Score" />
            </columns>
        </TableView>
        <HBox spacing="10" alignment="CENTER">    
            <Button fx:id="addButton" text="Add Team" onAction="#addTeam" />
            <Button fx:id="removeButton" text="Remove Team" onAction="#removeTeam" />
            <Button fx:id="editButton" text="Edit Team" /> 
        </HBox>
        <Button fx:id="leaderboardButton" text="Switch to Gameboard" onAction="#switchToGameboard" />
        <Button text="Back to Menu" onAction="#switchToLanding" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>

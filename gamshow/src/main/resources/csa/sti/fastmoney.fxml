<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="csa.sti.FastMoney" style="-fx-background-color: #7a7bb0; -fx-font-family: 'Segoe UI';">
    <children>
        <Label text="FAST MONEY" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #29243b;" />
        <HBox alignment="CENTER" spacing="12"
              style="-fx-background-color: #a3aeec; -fx-background-radius: 8; -fx-padding: 12 20 12 20;">
            <Label text="ROUND TIMER" style="-fx-text-fill: #29243b; -fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>

        <GridPane alignment="CENTER" hgap="12" vgap="8" maxWidth="900"
                  style="-fx-background-color: #f8f8ff; -fx-background-radius: 10; -fx-padding: 18;">
            <Label text="QUESTION" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
            <Label text="SURVEY ANSWER" GridPane.columnIndex="1" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
            <Label text="CONTESTANT 1" GridPane.columnIndex="2" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
            <Label text="PTS" GridPane.columnIndex="3" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
            <Label text="CONTESTANT 2" GridPane.columnIndex="4" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />
            <Label text="PTS" GridPane.columnIndex="5" GridPane.rowIndex="0"
                   style="-fx-text-fill: #494a69; -fx-font-weight: bold; -fx-padding: 0 0 8 0;" />

            <Label text="01" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label text="Survey question 1" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Label text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="1" />
            <Label text="-" GridPane.columnIndex="5" GridPane.rowIndex="1" />

            <Label text="02" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label text="Survey question 2" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Label text="-" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="2" />
            <Label text="-" GridPane.columnIndex="5" GridPane.rowIndex="2" />

            <Label text="03" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label text="Survey question 3" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Label text="-" GridPane.columnIndex="3" GridPane.rowIndex="3" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="3" />
            <Label text="-" GridPane.columnIndex="5" GridPane.rowIndex="3" />

            <Label text="04" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Label text="Survey question 4" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="4" />
            <Label text="-" GridPane.columnIndex="3" GridPane.rowIndex="4" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="4" />
            <Label text="-" GridPane.columnIndex="5" GridPane.rowIndex="4" />

            <Label text="05" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            <Label text="Survey question 5" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="2" GridPane.rowIndex="5" />
            <Label text="-" GridPane.columnIndex="3" GridPane.rowIndex="5" />
            <TextField promptText="Answer" prefWidth="150" GridPane.columnIndex="4" GridPane.rowIndex="5" />
            <Label text="-" GridPane.columnIndex="5" GridPane.rowIndex="5" />
        </GridPane>

        <HBox alignment="CENTER" spacing="24">
            <Label text="Contestant 1 total: 0" style="-fx-text-fill: #29243b; -fx-font-weight: bold;" />
            <Label text="Contestant 2 total: 0" style="-fx-text-fill: #29243b; -fx-font-weight: bold;" />
            <Label text="Winner: -" style="-fx-text-fill: #29243b; -fx-font-weight: bold;" />
        </HBox>

        <Button text="Back to Menu" onAction="#switchToLanding"
                style="-fx-background-color: #a3aeec; -fx-text-fill: #29243b; -fx-font-size: 16px; -fx-background-radius: 8; -fx-cursor: hand;" />
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
